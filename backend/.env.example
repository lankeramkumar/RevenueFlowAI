# Copy to .env and fill in real values. Never commit .env itself.
# Demo credentials below work only against the local Keycloak/Compose
# environment in infra/docker-compose.yml — they are not production secrets.

APP_ENV=development
DEMO_MODE=true

DATABASE_URL=postgresql+asyncpg://revenueflow:revenueflow@localhost:5432/revenueflow

OIDC_ISSUER=http://localhost:8080/realms/revenueflow
OIDC_AUDIENCE=revenueflow-backend
OIDC_JWKS_URL=http://localhost:8080/realms/revenueflow/protocol/openid-connect/certs
JWT_LEEWAY_SECONDS=10

# LocalStack accepts any non-empty credentials for its S3 service locally.
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET_RAW_IMPORTS=raw-imports
S3_BUCKET_EXPORTS=exports
S3_REGION=us-east-1

# Optional: enables live Anthropic-backed investigations. Omit to run in
# demo-provider-only mode (no key required).
# ANTHROPIC_API_KEY=

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
